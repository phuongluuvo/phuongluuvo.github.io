# Keep the jemdoc sources and the generated HTML in LF (Unix) line endings.
# jemdoc reads blank lines to decide where a paragraph ends, and a Windows
# CRLF line ending breaks that logic -- so this matters.
*.jemdoc text eol=lf
*.conf    text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.bib     text eol=lf
*.svg     text eol=lf
Makefile  text eol=lf

# Real binary files.
*.pdf     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
